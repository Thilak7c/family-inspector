# Required
TELEGRAM_BOT_TOKEN=replace_me
# Use polling for a laptop/local demo (no public URL required). Use webhook when
# deployed to Cloud Run.
TELEGRAM_MODE=polling
SAFE_BROWSING_API_KEY=replace_me
GROQ_API_KEY=replace_me
# Optional: use a different Groq model if your event credits specify one.
GROQ_MODEL=openai/gpt-oss-120b

# Public HTTPS service URL, used by npm run set-webhook
PUBLIC_BASE_URL=https://your-service-xxxxx-uc.a.run.app

# Optional: set to true only after a Firestore database is available in the
# Cloud Run project. Otherwise events remain in memory (ideal for a quick demo).
USE_FIRESTORE=false
FIRESTORE_COLLECTION=family_guard_events

# Optional shared secret checked on Telegram webhook calls.
TELEGRAM_WEBHOOK_SECRET=replace_with_a_long_random_value
